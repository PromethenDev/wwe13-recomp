diff --git a/port/src/native/svr_resources.cpp b/port/src/native/svr_resources.cpp
index 704a871..c7f9867 100644
--- a/port/src/native/svr_resources.cpp
+++ b/port/src/native/svr_resources.cpp
@@ -1413,4 +1413,118 @@ GuestTexture *SvrResolveTexture(u32 texture_va) {
   return check.host ? check.host : TargetWithSameMemory(texture_va);
 }
 
+// ---- wwe13_skip_unread_targets ---------------------------------------------------------------
+// Offline evidence (recorder + replay, 11-20): 20 64x64 targets per frame in a match are resolved
+// and never bound or presented; skipping them left the replayed picture byte-identical. The rule is
+// history-based, so a read after skipping started is logged (the content is then stale).
+REXCVAR_DEFINE_BOOL(wwe13_skip_unread_targets, false, "WWE13",
+                    "Skip resolves into targets nothing has read for 120+ frames in a row, and the "
+                    "draws and clears that only feed them (default off; logs mispredicts)");
+
+namespace {
+struct UnreadTarget {
+  u32 va = 0;
+  u64 last_frame = ~0ull;
+  u32 frames = 0;
+  bool read = false;
+  bool skipping = false;
+};
+constexpr u32 kUnreadFrames = 120;
+std::mutex g_unread_mutex;
+std::unordered_map<const GuestTexture *, UnreadTarget> g_unread;
+std::unordered_map<u32, u8> g_read_vas;          // texture headers bound or presented
+std::unordered_map<u32, u64> g_dead_surfaces;    // surface va -> frame of its last skipped resolve
+std::atomic<u32> g_unread_logged{0};
+std::atomic<u32> g_unread_mispredicts{0};
+
+bool UnreadEnabled() {
+  static const bool on = REXCVAR_GET(wwe13_skip_unread_targets);
+  return on;
+}
+
+void LogMispredict(const char *what, u32 va) {
+  const u32 n = g_unread_mispredicts.fetch_add(1, std::memory_order_relaxed);
+  if (n < 32)
+    BD_WARN("[svr] skip-unread MISPREDICT #{}: {} 0x{:08X} (frame {})", n + 1, what, va,
+            g_frame_index.load(std::memory_order_relaxed));
+}
+}  // namespace
+
+void SvrNoteTextureRead(const GuestTexture *tex, u32 texture_va) {
+  if (!UnreadEnabled() || !texture_va)
+    return;
+  std::lock_guard lock(g_unread_mutex);
+  g_read_vas[texture_va] = 1;
+  if (!tex)
+    return;
+  const auto it = g_unread.find(tex);
+  if (it == g_unread.end()) {
+    g_unread[tex].read = true;
+    return;
+  }
+  if (it->second.skipping)
+    LogMispredict("target read after its resolves were skipped", it->second.va);
+  it->second.read = true;
+  it->second.skipping = false;
+}
+
+bool SvrSkipUnreadResolve(u32 dst_va, const GuestTexture *dst, u32 flags, u32 level, u32 face,
+                          u32 rt_va, u32 ds_va) {
+  if (!UnreadEnabled())
+    return false;
+  const u64 frame = g_frame_index.load(std::memory_order_relaxed);
+  std::lock_guard lock(g_unread_mutex);
+  bool skip = false;
+  // Clearing resolves (0x300) and other levels/faces always run.
+  if (dst && !(flags & 0x300u) && level == 0 && face == 0 && !g_read_vas.count(dst_va)) {
+    UnreadTarget &u = g_unread[dst];
+    if (u.va != dst_va)
+      u = UnreadTarget{};  // a new target in a reused host object
+    u.va = dst_va;
+    if (!u.read) {
+      if (u.last_frame != frame) {
+        u.frames = (u.last_frame + 1 == frame) ? u.frames + 1 : 1;
+        u.last_frame = frame;
+      }
+      skip = u.frames >= kUnreadFrames;
+      if (skip && !u.skipping && g_unread_logged.fetch_add(1, std::memory_order_relaxed) < 64)
+        BD_INFO("[svr] skip-unread: target 0x{:08X} {}x{} (surface 0x{:08X}) unread for {} frames, "
+                "its resolves are skipped from frame {}",
+                dst_va, dst->width, dst->height, rt_va, u.frames, frame);
+      u.skipping = skip;
+    }
+  }
+  if (skip) {
+    if (rt_va)
+      g_dead_surfaces[rt_va] = frame;
+    if (ds_va)
+      g_dead_surfaces[ds_va] = frame;
+    return true;
+  }
+  // A surface whose draws were being skipped now feeds a live copy: those draws were needed.
+  for (const u32 sv : {rt_va, ds_va}) {
+    if (!sv)
+      continue;
+    const auto it = g_dead_surfaces.find(sv);
+    if (it == g_dead_surfaces.end())
+      continue;
+    if (it->second + 1 >= frame)
+      LogMispredict("surface with skipped draws resolved into a live target", sv);
+    g_dead_surfaces.erase(it);
+  }
+  return false;
+}
+
+bool SvrSkipDeadSurfaceWork(u32 rt0, u32 rt1, u32 rt2, u32 rt3, u32 ds) {
+  if (!UnreadEnabled() || !rt0 || rt1 || rt2 || rt3)
+    return false;
+  const u64 frame = g_frame_index.load(std::memory_order_relaxed);
+  std::lock_guard lock(g_unread_mutex);
+  const auto dead = [&](u32 sv) {
+    const auto it = g_dead_surfaces.find(sv);
+    return it != g_dead_surfaces.end() && it->second + 1 >= frame;
+  };
+  return dead(rt0) && (!ds || dead(ds));
+}
+
 }  // namespace bd::gpu
