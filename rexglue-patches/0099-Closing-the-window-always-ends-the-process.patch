From c07f87d5bae4a4b237580cb48928a9183c35f9cb Mon Sep 17 00:00:00 2001
From: PromethenDev <PromethenDev@users.noreply.github.com>
Date: Tue, 13 Oct 2026 08:51:43 -0700
Subject: [PATCH 99/99] Closing the window always ends the process

After the window is closed, force the process to exit if shutdown has not
finished within close_exit_timeout_seconds (default 3). On Windows this uses
TerminateProcess so a blocked DLL detach cannot keep the game running in the
background.
---
 src/ui/rex_app.cpp | 38 ++++++++++++++++++++++++++++++++++++++
 1 file changed, 38 insertions(+)

diff --git a/src/ui/rex_app.cpp b/src/ui/rex_app.cpp
index f8e1e56..2e0e09c 100644
--- a/src/ui/rex_app.cpp
+++ b/src/ui/rex_app.cpp
@@ -12,6 +12,11 @@
 #include <rex/rex_app.h>
 
 #include <chrono>
+#include <cstdlib>
+#include <thread>
+#ifdef _WIN32
+#include <windows.h>
+#endif
 
 #include <rex/cvar.h>
 #include <rex/diagnostics/freeze_logger.h>
@@ -56,6 +61,10 @@ REXCVAR_DEFINE_INT32(replay_trace_repeat, 1, "GPU",
 REXCVAR_DEFINE_STRING(replay_trace_out, "", "GPU",
                       "Output image (.ppm) for replay_trace; default: trace path + .ppm");
 REXCVAR_DEFINE_STRING(update_data_root, "", "Runtime", "Override update data path");
+REXCVAR_DEFINE_INT32(close_exit_timeout_seconds, 3, "Runtime",
+                     "After the window is closed, force the process to exit if shutdown has not "
+                     "finished within this many seconds (0 = wait forever)")
+    .range(0, 600);
 REXCVAR_DEFINE_BOOL(debug_ui, false, "UI/Debug",
                     "Enable developer overlays, hotkeys, and the Windows console")
     .lifecycle(rex::cvar::Lifecycle::kRequiresRestart);
@@ -375,6 +384,19 @@ void ReXApp::OnKeyDown(ui::KeyEvent& e) {
   rex::ui::ProcessKeyEvent(e);
 }
 
+namespace {
+// Ends the process immediately. On Windows _Exit/ExitProcess still run every DLL's
+// DLL_PROCESS_DETACH under the loader lock; a GPU driver DLL that waits on a thread
+// frozen by TerminateTitle then keeps the process alive in the background forever.
+// TerminateProcess skips that detach path.
+[[noreturn]] void HardExitProcess() {
+#ifdef _WIN32
+  TerminateProcess(GetCurrentProcess(), 0);
+#endif
+  std::_Exit(0);
+}
+}  // namespace
+
 void ReXApp::OnClosing(ui::UIEvent& e) {
   (void)e;
   REXLOG_INFO("Window closing, shutting down...");
@@ -388,6 +410,22 @@ void ReXApp::OnClosing(ui::UIEvent& e) {
   rex::diagnostics::freeze_logger::SnapshotOnClose();
   rex::diagnostics::freeze_logger::Stop();
   REXLOG_INFO("[freeze-logger] disarmed at window close");
+  // TerminateTitle() or later teardown can block. The player asked to quit, so
+  // force the process to exit if shutdown has not completed within the timeout.
+  if (const int timeout_s = REXCVAR_GET(close_exit_timeout_seconds); timeout_s > 0) {
+    std::thread([timeout_s] {
+      std::this_thread::sleep_for(std::chrono::seconds(timeout_s));
+      // Logging can also block on a lock held by a suspended guest thread. Keep
+      // a second exit path that does not touch any logger or other lock.
+      std::thread([] {
+        std::this_thread::sleep_for(std::chrono::seconds(2));
+        HardExitProcess();
+      }).detach();
+      REXLOG_WARN("Shutdown still running {} s after the window closed; exiting now", timeout_s);
+      rex::FlushLogging();
+      HardExitProcess();
+    }).detach();
+  }
   shutting_down_.store(true, std::memory_order_release);
   if (runtime_ && runtime_->kernel_state()) {
     runtime_->kernel_state()->TerminateTitle();
