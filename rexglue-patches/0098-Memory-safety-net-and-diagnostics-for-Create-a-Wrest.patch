+void Memory::DumpHeapSummary(FILE* file, const char* reason) {
+  struct Row {
+    const char* name;
+    BaseHeap* heap;
+    uint32_t low;
+    uint32_t high;
+  };
+  const Row rows[] = {
+      {"v00000000 guest", &heaps_.v00000000, 0x00000000, 0x2FFFFFFF},
+      {"v00000000 system", &heaps_.v00000000, 0x30000000, 0x3FFFFFFF},
+      {"v40000000 guest", &heaps_.v40000000, 0x40000000, 0x6FFFFFFF},
+      {"v40000000 stacks/system", &heaps_.v40000000, 0x70000000, 0x7EFFFFFF},
+      {"v80000000 xex", &heaps_.v80000000, 0x80000000, 0x8FFFFFFF},
+      {"v90000000 xex", &heaps_.v90000000, 0x90000000, 0x9FFFFFFF},
+      {"physical (512 MB)", &heaps_.physical, 0x00000000, 0x1FFFFFFF},
+  };
+  for (const auto& row : rows) {
+    const auto st = row.heap->GetRangeStats(row.low, row.high);
+    if (file) {
+      std::fprintf(file, "heap %-24s %08X-%08X free=%.1f MB of %.1f MB largest_free=%.1f MB\n",
+                   row.name, row.low, row.high, double(st.free_bytes) / 1048576.0,
+                   double(st.total_bytes) / 1048576.0, double(st.largest_free_bytes) / 1048576.0);
+    } else {
+      REXSYS_WARN(
+          "[heap-summary] {} {}: {:08X}-{:08X} free={:.1f} MB of {:.1f} MB, largest_free={:.1f} MB",
+          reason ? reason : "", row.name, row.low, row.high, double(st.free_bytes) / 1048576.0,
+          double(st.total_bytes) / 1048576.0, double(st.largest_free_bytes) / 1048576.0);
+    }
+  }
+  if (file) {
+    heaps_.physical.DumpRegions(file);
+  }
+}
+
+void Memory::LogHeapSummary(const char* reason) {
+  DumpHeapSummary(nullptr, reason);
+}
