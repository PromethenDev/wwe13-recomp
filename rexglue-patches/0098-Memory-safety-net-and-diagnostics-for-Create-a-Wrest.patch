+struct AllocFailureHeapState {
+  uint32_t heap_base = 0;
+  uint32_t logged = 0;
+  uint64_t last_detail_ns = 0;
+};
+std::mutex g_alloc_failure_heap_mutex;
+AllocFailureHeapState g_alloc_failure_heaps[16];
+constexpr uint32_t kAllocFailureDetailsPerHeap = 6;
+constexpr uint64_t kAllocFailureDetailIntervalNs = 5000000000ull;
+
+uint32_t CurrentGuestLr() {
+  const auto* thread_state = rex::runtime::ThreadState::Get();
+  const auto* context = thread_state ? thread_state->context() : nullptr;
+  return context ? static_cast<uint32_t>(context->lr) : 0;
+}
+
+// Detailed record of a failed guest allocation: which heap and range, how much
+// was asked for, how much of the range is free and how big the largest free
+// block is, and the guest caller. The first few failures per heap are logged,
+// then one every few seconds, so a long run of failures cannot flood the log.
+void LogAllocFailureDetail(const BaseHeap* heap, uint32_t low, uint32_t high, uint32_t size,
+                           uint64_t now) {
+  if (!heap) {
+    return;
+  }
+  {
+    std::lock_guard<std::mutex> lock(g_alloc_failure_heap_mutex);
+    AllocFailureHeapState* state = nullptr;
+    for (auto& s : g_alloc_failure_heaps) {
+      if (s.heap_base == heap->heap_base() + 1 || s.heap_base == 0) {
+        state = &s;
+        break;
+      }
+    }
+    if (!state) {
+      return;
+    }
+    state->heap_base = heap->heap_base() + 1;  // 0 means unused
+    if (state->logged >= kAllocFailureDetailsPerHeap &&
+        now - state->last_detail_ns < kAllocFailureDetailIntervalNs) {
+      return;
+    }
+    ++state->logged;
+    state->last_detail_ns = now;
+  }
+  const auto stats = const_cast<BaseHeap*>(heap)->GetRangeStats(low, high);
+  REXSYS_ERROR(
+      "[alloc-fail-detail] heap={:08X}-{:08X} page={:#x} range={:08X}-{:08X} requested={:#x} "
+      "free={:#x} of {:#x} largest_free={:#x} guest_lr={:08X}",
+      heap->heap_base(), heap->heap_base() + (heap->heap_size() - 1), heap->page_size(), low, high,
+      size, stats.free_bytes, stats.total_bytes, stats.largest_free_bytes, CurrentGuestLr());
+}
