+void BaseHeap::DumpRegions(FILE* file) {
+  std::lock_guard<std::recursive_mutex> heap_lock(heap_mutex_);
+  struct Bucket {
+    const char* name;
+    uint64_t limit;
+    uint32_t count = 0;
+    uint64_t bytes = 0;
+  } buckets[] = {{"<64KB", 0x10000}, {"<1MB", 0x100000}, {"<4MB", 0x400000},
+                 {"<16MB", 0x1000000}, {">=16MB", ~0ull}};
+  std::fprintf(file, "regions of heap %08X-%08X (page %#x):\n", heap_base_,
+               heap_base_ + (heap_size_ - 1), page_size_);
+  const uint32_t count = uint32_t(page_table_.size());
+  for (uint32_t i = 0; i < count; ++i) {
+    const auto& page = page_table_[i];
+    if (!page.state) {
+      continue;
+    }
+    const uint32_t pages = std::max<uint32_t>(page.region_page_count, 1);
+    const uint64_t bytes = uint64_t(pages) << page_size_shift_;
+    for (auto& bucket : buckets) {
+      if (bytes < bucket.limit) {
+        ++bucket.count;
+        bucket.bytes += bytes;
+        break;
+      }
+    }
+    std::fprintf(file, "  %08X %9llu KB\n", heap_base_ + (i << page_size_shift_),
+                 static_cast<unsigned long long>(bytes / 1024));
+    i += pages - 1;
+  }
+  for (const auto& bucket : buckets) {
+    std::fprintf(file, "  size %-7s regions=%u total=%.1f MB\n", bucket.name, bucket.count,
+                 double(bucket.bytes) / 1048576.0);
+  }
+}
+
+BaseHeap::RangeStats BaseHeap::GetRangeStats(uint32_t low_address, uint32_t high_address) {
+  RangeStats stats;
+  if (page_table_.empty() || high_address < low_address) {
+    return stats;
+  }
+  low_address = std::max(low_address, heap_base_);
+  high_address = std::min(high_address, heap_base_ + (heap_size_ - 1));
+  if (high_address < low_address) {
+    return stats;
+  }
+  std::lock_guard<std::recursive_mutex> heap_lock(heap_mutex_);
+  const uint32_t low_page = (low_address - heap_base_) >> page_size_shift_;
+  const uint32_t high_page =
+      std::min(uint32_t(page_table_.size()) - 1, (high_address - heap_base_) >> page_size_shift_);
+  uint32_t run = 0, largest = 0, free_pages = 0;
+  for (uint32_t i = low_page; i <= high_page; ++i) {
+    if (page_table_[i].state == 0) {
+      ++run;
+      ++free_pages;
+      largest = std::max(largest, run);
+    } else {
+      run = 0;
+    }
+  }
+  stats.total_bytes = (high_page - low_page + 1) << page_size_shift_;
+  stats.free_bytes = free_pages << page_size_shift_;
+  stats.largest_free_bytes = largest << page_size_shift_;
+  return stats;
+}
