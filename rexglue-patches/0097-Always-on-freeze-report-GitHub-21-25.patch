+uint64_t RecordedEventCount() { return g_event_count.load(std::memory_order_relaxed); }
+
+bool IsEnabled() { return g_enabled.load(std::memory_order_relaxed); }
+
+void SetGuestStateDumpFn(GuestStateDumpFn fn) { g_guest_state_dump = fn; }
+
+void RecordMemoryRecovery(MemoryRecoveryKind kind, uint32_t guest_address, uint32_t protect) {
+  const int index = static_cast<int>(kind);
+  if (index < 0 || index >= static_cast<int>(MemoryRecoveryKind::kCount)) return;
+  RecoverySlot& slot = g_recovery[index];
+  slot.count.fetch_add(1, std::memory_order_relaxed);
+  slot.last_guest.store(guest_address, std::memory_order_relaxed);
+  slot.last_protect.store(protect, std::memory_order_relaxed);
+  slot.last_ns.store(NowNs(), std::memory_order_release);
+}
