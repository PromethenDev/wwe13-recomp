+// Always-on freeze logger (see include/rex/diagnostics/freeze_logger.h).
+//
+// Design constraints:
+//   * negligible always-on cost: a 1 Hz watchdog thread, no sampling profiler;
+//   * a fixed lock-free ring of kernel synchronization events, no locks,
+//     no allocation on the producer hot path;
+//   * on freeze, write ONE report (threads + waits + ring + log tail) into the
+//     player's logs folder and keep the game running;
+//   * never crash or deadlock the game: the watchdog only takes its own
+//     lifecycle mutex and reads snapshot atomics / fixed slots.
+//
+// This file must not depend on rex::system (rexcore is lower in the stack), so
+// the guest link register at a wait is supplied by the kernel caller and the
+// per-thread state is a snapshot of atomics.
+
+#include <rex/diagnostics/freeze_logger.h>
+
+#include <algorithm>
+#include <atomic>
+#include <bit>
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+#include <rex/cvar.h>
+#include <rex/filesystem.h>
+#include <rex/logging.h>
+#include <rex/logging/api.h>
+#include <rex/thread.h>
+
+#if defined(_WIN32)
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#else
+#include <elf.h>
+#include <execinfo.h>
+#include <fcntl.h>
+#include <link.h>
+#include <signal.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#endif
+
+namespace rex::diagnostics::freeze_logger {
+namespace {
+
+constexpr uint32_t kRingSize = 4096;
+constexpr int kMaxThreads = 64;
+constexpr uint32_t kMaxCaptureDepth = 24;
+constexpr int kFreezeGapSeconds = 10;
+// Exit snapshot: how many wwe13-exit-*.txt files to keep, and the wait length
+// counted as long in the exit summary line.
+constexpr size_t kKeepExitSnapshots = 3;
+constexpr int kLongWaitSeconds = 15;
+// Per-thread CPU classification and multi-sample spin PC capture.
+constexpr int kMaxSpinSamples = 20;
+constexpr int kSpinSampleIntervalMs = 50;  // 20 samples * 50 ms = 1 s
+constexpr int kCpuHistory = 8;             // 1 Hz watchdog samples kept per slot
+constexpr double kSpinCpuPercent = 50.0;   // >= this and not waiting => spin
+// Linux backtrace frame holding the interrupted instruction (frames 0/1 are the
+// capture signal handler and the libc signal trampoline).
+constexpr int kInterruptedFrame = 2;
+
+std::atomic<bool> g_started{false};
+std::atomic<bool> g_enabled{false};
+std::atomic<bool> g_running{false};
+std::mutex g_lifecycle;
+std::thread g_watchdog;
+
+std::atomic<uint64_t> g_last_present_ns{0};
+std::atomic<uint64_t> g_present_count{0};
+std::atomic<uint64_t> g_last_vdswap_ns{0};
+std::atomic<uint64_t> g_vdswap_count{0};
+std::atomic<uint32_t> g_last_present_host_tid{0};
+std::atomic<uint32_t> g_last_vdswap_host_tid{0};
+std::atomic<bool> g_reported{false};
+std::atomic<uint64_t> g_event_count{0};
+uint64_t g_start_ns = 0;
+
+// --- ring buffer -----------------------------------------------------------
+
+struct SyncRecord {
+  uint16_t kind;
+  uint16_t object_type;
+  uint32_t host_tid;
+  uint32_t guest_id;
+  uint32_t handle;
+  uint64_t t_ns;
+  char name[32];
+};
+
+struct RingSlot {
+  std::atomic<uint64_t> seq{0};
+  SyncRecord rec{};
+};
+
+RingSlot g_ring[kRingSize];
+std::atomic<uint64_t> g_ring_write{0};
+
+// --- per-thread snapshot ---------------------------------------------------
+
+struct ThreadSlot {
+  std::atomic<bool> active{false};
+  std::atomic<uint32_t> guest_id{0};
+  std::atomic<uint32_t> host_tid{0};
+  char name[48] = {};
+  std::atomic<uint64_t> wait_since_ns{0};
+  std::atomic<uint32_t> wait_handle{0};
+  std::atomic<uint32_t> wait_object_type{0};
+  std::atomic<uint64_t> wait_lr{0};
+  char wait_name[48] = {};
+  std::atomic<uint32_t> cap_depth{0};
+  std::atomic<uint64_t> cap_pc[kMaxCaptureDepth] = {};
+  // Leaf host PCs gathered by repeated capture signals at report time.
+  std::atomic<uint32_t> spin_count{0};
+  std::atomic<uint64_t> spin_pc[kMaxSpinSamples] = {};
+};
+
+ThreadSlot g_slots[kMaxThreads];
+std::atomic<uint64_t> g_used_mask{0};
+std::atomic<bool> g_spin_sampling{false};
+GuestStateDumpFn g_guest_state_dump = nullptr;
+#if !defined(_WIN32)
+thread_local ThreadSlot* t_slot = nullptr;
+int g_capture_signal = 0;
+#else
+thread_local ThreadSlot* t_slot = nullptr;
+#endif
+
+// Per-slot CPU history. Written and read only by the watchdog thread; a
+// slot's history is matched by host_tid so slot reuse is harmless.
+struct CpuSample {
+  uint32_t host_tid = 0;
+  uint64_t cpu_ns = 0;
+  uint64_t t_ns = 0;
+};
+CpuSample g_cpu_history[kMaxThreads][kCpuHistory];
+uint32_t g_cpu_history_head[kMaxThreads] = {};
+uint32_t g_cpu_history_count[kMaxThreads] = {};
+
+// Access-violation recovery accounting.
+struct RecoverySlot {
+  std::atomic<uint64_t> count{0};
+  std::atomic<uint32_t> last_guest{0};
+  std::atomic<uint32_t> last_protect{0};
+  std::atomic<uint64_t> last_ns{0};
+};
+RecoverySlot g_recovery[static_cast<int>(MemoryRecoveryKind::kCount)];
+
+uint64_t NowNs() {
+  const auto now = std::chrono::steady_clock::now().time_since_epoch();
+  return uint64_t(std::chrono::duration_cast<std::chrono::nanoseconds>(now).count());
+}
+
+// --- host symbol table (Linux ELF .symtab) ---------------------------------
+//
+// The recompiled guest functions are plain local symbols (sub_XXXXXXXX) in the
+// game binary's .symtab; there is no dynamic symbol table and no -rdynamic, so
+// dladdr/backtrace_symbols cannot resolve them. Parse /proc/self/exe lazily the
+// first time a report is generated and map a host PC to the nearest preceding
+// function symbol (subtracting the PIE load bias). On Windows the symbols live
+// in the unshipped .pdb, so callers fall back to raw addresses.
+
+struct SymbolEntry {
+  uint64_t addr;
+  const char* name;
+};
+std::vector<SymbolEntry> g_symbols;
+std::vector<char> g_symbol_strings;
+uint64_t g_symbol_base = 0;
+bool g_symbols_loaded = false;
+
+#if !defined(_WIN32)
+int SymbolsPhdrCallback(struct dl_phdr_info* info, size_t, void*) {
+  if (!info->dlpi_name || info->dlpi_name[0] == '\0') {
+    g_symbol_base = static_cast<uint64_t>(info->dlpi_addr);
+    return 1;
+  }
+  return 0;
+}
+
+void LoadSymbols() {
+  if (g_symbols_loaded) return;
+  g_symbols_loaded = true;
+  dl_iterate_phdr(SymbolsPhdrCallback, nullptr);
+  const int fd = ::open("/proc/self/exe", O_RDONLY | O_CLOEXEC);
+  if (fd < 0) return;
+  Elf64_Ehdr eh{};
+  if (::pread(fd, &eh, sizeof(eh), 0) != static_cast<ssize_t>(sizeof(eh)) ||
+      std::memcmp(eh.e_ident, ELFMAG, SELFMAG) != 0 ||
+      eh.e_shentsize != sizeof(Elf64_Shdr) || eh.e_shnum == 0) {
+    ::close(fd);
+    return;
+  }
+  std::vector<Elf64_Shdr> sections(eh.e_shnum);
+  if (::pread(fd, sections.data(), sections.size() * sizeof(Elf64_Shdr), eh.e_shoff) !=
+      static_cast<ssize_t>(sections.size() * sizeof(Elf64_Shdr))) {
+    ::close(fd);
+    return;
+  }
+  const Elf64_Shdr* symtab = nullptr;
+  for (const Elf64_Shdr& sh : sections) {
+    if (sh.sh_type == SHT_SYMTAB) {
+      symtab = &sh;
+      break;
+    }
+  }
+  if (!symtab || symtab->sh_link >= sections.size()) {
+    ::close(fd);
+    return;
+  }
+  const Elf64_Shdr& strtab = sections[symtab->sh_link];
+  const size_t symbol_count = symtab->sh_size / sizeof(Elf64_Sym);
+  if (symbol_count == 0 || strtab.sh_size == 0) {
+    ::close(fd);
+    return;
+  }
+  std::vector<Elf64_Sym> symbols(symbol_count);
+  if (::pread(fd, symbols.data(), symtab->sh_size, symtab->sh_offset) !=
+      static_cast<ssize_t>(symtab->sh_size)) {
+    ::close(fd);
+    return;
+  }
+  g_symbol_strings.resize(strtab.sh_size);
+  if (::pread(fd, g_symbol_strings.data(), strtab.sh_size, strtab.sh_offset) !=
+      static_cast<ssize_t>(strtab.sh_size)) {
+    g_symbol_strings.clear();
+    ::close(fd);
+    return;
+  }
+  ::close(fd);
+  g_symbols.reserve(symbol_count);
+  for (const Elf64_Sym& sym : symbols) {
+    if (sym.st_name == 0 || sym.st_shndx == SHN_UNDEF) continue;
+    const int type = ELF64_ST_TYPE(sym.st_info);
+    if (type != STT_FUNC && type != STT_OBJECT) continue;
+    if (sym.st_name >= g_symbol_strings.size()) continue;
+    g_symbols.push_back({sym.st_value, g_symbol_strings.data() + sym.st_name});
+  }
+  std::sort(g_symbols.begin(), g_symbols.end(),
+            [](const SymbolEntry& a, const SymbolEntry& b) { return a.addr < b.addr; });
+}
+#endif
+
+const char* SymbolizeHostPc(uint64_t pc) {
+#if defined(_WIN32)
+  (void)pc;
+  return nullptr;
+#else
+  if (g_symbols.empty()) return nullptr;
+  const uint64_t addr = pc >= g_symbol_base ? pc - g_symbol_base : pc;
+  auto it = std::upper_bound(g_symbols.begin(), g_symbols.end(), addr,
+                             [](uint64_t value, const SymbolEntry& entry) {
+                               return value < entry.addr;
+                             });
+  if (it == g_symbols.begin()) return nullptr;
+  --it;
+  return it->name;
+#endif
+}
+
+// Per-thread host CPU time in nanoseconds, or UINT64_MAX if unavailable.
+uint64_t ReadHostCpuNs(uint32_t tid) {
+#if defined(_WIN32)
+  if (tid == 0) return UINT64_MAX;
+  HANDLE handle = OpenThread(THREAD_QUERY_INFORMATION, FALSE, tid);
+  if (!handle) return UINT64_MAX;
+  FILETIME creation{}, exit{}, kernel{}, user{};
+  uint64_t total = UINT64_MAX;
+  if (GetThreadTimes(handle, &creation, &exit, &kernel, &user)) {
+    auto to_u64 = [](const FILETIME& value) {
+      return (uint64_t(value.dwHighDateTime) << 32) | value.dwLowDateTime;
+    };
+    total = (to_u64(kernel) + to_u64(user)) * 100ull;  // 100 ns ticks -> ns
+  }
+  CloseHandle(handle);
+  return total;
+#else
+  if (tid == 0) return UINT64_MAX;
+  std::ifstream input("/proc/self/task/" + std::to_string(tid) + "/stat");
+  std::string line;
+  if (!input || !std::getline(input, line)) return UINT64_MAX;
+  const size_t name_end = line.rfind(") ");
+  if (name_end == std::string::npos) return UINT64_MAX;
+  // After the comm field: state (a single non-numeric char) then ppid(0) pgrp(1)
+  // session(2) tty(3) tpgid(4) flags(5) minflt(6) cminflt(7) majflt(8)
+  // cmajflt(9) utime(10) stime(11).
+  char* cursor = const_cast<char*>(line.c_str()) + name_end + 2;
+  while (*cursor && *cursor != ' ') ++cursor;  // skip the state char
+  while (*cursor == ' ') ++cursor;
+  long fields[12] = {};
+  for (int i = 0; i < 12 && *cursor; ++i) {
+    fields[i] = std::strtol(cursor, &cursor, 10);
+    while (*cursor == ' ') ++cursor;
+  }
+  const long clk_tck = ::sysconf(_SC_CLK_TCK);
+  if (clk_tck <= 0) return UINT64_MAX;
+  const uint64_t ticks = uint64_t(fields[10] < 0 ? 0 : fields[10]) +
+                         uint64_t(fields[11] < 0 ? 0 : fields[11]);
+  return ticks * 1000000000ull / uint64_t(clk_tck);
+#endif
+}
+
+// Mean host CPU percent for a slot over the retained watchdog samples, matched
+// by host_tid. Returns -1 when there is not enough history.
+double SlotCpuPercent(int index) {
+  const ThreadSlot& slot = g_slots[index];
+  const uint32_t tid = slot.host_tid.load(std::memory_order_relaxed);
+  const uint32_t count = std::min<uint32_t>(g_cpu_history_count[index], kCpuHistory);
+  if (tid == 0 || count < 2) return -1.0;
+  uint64_t newest_t = 0, oldest_t = 0, newest_cpu = 0, oldest_cpu = 0;
+  bool have_newest = false, have_oldest = false;
+  for (uint32_t i = 0; i < count; ++i) {
+    const CpuSample& sample = g_cpu_history[index][i];
+    if (sample.host_tid != tid) continue;
+    if (!have_newest || sample.t_ns > newest_t) {
+      newest_t = sample.t_ns;
+      newest_cpu = sample.cpu_ns;
+      have_newest = true;
+    }
+    if (!have_oldest || sample.t_ns < oldest_t) {
+      oldest_t = sample.t_ns;
+      oldest_cpu = sample.cpu_ns;
+      have_oldest = true;
+    }
+  }
+  if (!have_newest || !have_oldest || newest_t <= oldest_t || newest_cpu < oldest_cpu) return -1.0;
+  const double wall_ns = double(newest_t - oldest_t);
+  const double cpu_ns = double(newest_cpu - oldest_cpu);
+  return 100.0 * cpu_ns / wall_ns;
+}
+
+const char* ClassifyThread(int index, double cpu_percent) {
+  // CPU first: a thread burning CPU is spinning regardless of a stale wait
+  // record (the guest Wwise threads keep a wait marker but run at ~100%).
+  if (cpu_percent >= kSpinCpuPercent) return "spin";
+  if (g_slots[index].wait_since_ns.load(std::memory_order_acquire) != 0) return "blocked";
+  if (cpu_percent < 0.0) return "unknown";
+  return "idle";
+}
+
+const char* ObjectTypeName(uint32_t type) {
+  // Mirrors rex::system::XObject::Type (include/rex/system/xobject.h).
+  static const char* kNames[] = {
+      "Undefined", "Enumerator", "Event",       "File",    "IOCompletion",
+      "Module",    "Mutant",     "Notify",      "Semaphore", "Session",
+      "Socket",    "SymLink",    "Thread",      "Timer",
+  };
+  if (type < sizeof(kNames) / sizeof(kNames[0])) return kNames[type];
+  return "?";
+}
+
+void PushEvent(SyncType type, uint32_t handle, uint32_t object_type, const char* name) {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  ThreadSlot* slot = t_slot;
+  SyncRecord rec{};
+  rec.kind = static_cast<uint16_t>(type);
+  rec.object_type = static_cast<uint16_t>(object_type);
+  rec.host_tid = rex::thread::current_thread_system_id();
+  rec.guest_id = slot ? slot->guest_id.load(std::memory_order_relaxed) : 0;
+  rec.handle = handle;
+  rec.t_ns = NowNs();
+  if (name && *name) {
+    std::strncpy(rec.name, name, sizeof(rec.name) - 1);
+  }
+  const uint64_t seq = g_ring_write.fetch_add(1, std::memory_order_relaxed);
+  RingSlot& entry = g_ring[seq % kRingSize];
+  entry.seq.store(seq * 2 + 1, std::memory_order_release);
+  entry.rec = rec;
+  entry.seq.store(seq * 2 + 2, std::memory_order_release);
+  g_event_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+#if !defined(_WIN32)
+// One-shot capture handler. Runs on the target thread; captures a host backtrace
+// (symbolizable to guest functions with the shipped binary) into its slot.
+void OnCaptureSignal(int, siginfo_t*, void*) {
+  ThreadSlot* slot = t_slot;
+  if (!slot) return;
+  void* frames[kMaxCaptureDepth];
+  const int depth = ::backtrace(frames, kMaxCaptureDepth);
+  const int clamped = depth < 0 ? 0 : std::min<int>(depth, kMaxCaptureDepth);
+  for (int i = 0; i < clamped; ++i) {
+    slot->cap_pc[i].store(reinterpret_cast<uint64_t>(frames[i]), std::memory_order_relaxed);
+  }
+  slot->cap_depth.store(static_cast<uint32_t>(clamped), std::memory_order_release);
+  if (g_spin_sampling.load(std::memory_order_relaxed)) {
+    // The interrupted instruction is frame 2 (0 = this handler, 1 = the libc
+    // signal trampoline); fall back to the shallowest frame we have.
+    uint64_t pc = 0;
+    if (clamped > kInterruptedFrame) {
+      pc = reinterpret_cast<uint64_t>(frames[kInterruptedFrame]);
+    } else if (clamped > 0) {
+      pc = reinterpret_cast<uint64_t>(frames[clamped - 1]);
+    }
+    const uint32_t sample = slot->spin_count.fetch_add(1, std::memory_order_relaxed);
+    if (sample < kMaxSpinSamples) {
+      slot->spin_pc[sample].store(pc, std::memory_order_relaxed);
+    }
+  }
+}
+#endif
+
+void InstallCaptureHandler() {
+#if !defined(_WIN32)
+  g_capture_signal = SIGRTMIN + 3;
+  struct sigaction action {};
+  action.sa_sigaction = OnCaptureSignal;
+  action.sa_flags = SA_SIGINFO | SA_RESTART;
+  sigemptyset(&action.sa_mask);
+  sigaction(g_capture_signal, &action, nullptr);
+#endif
+}
+
+void RequestCapture(ThreadSlot* slot) {
+#if defined(_WIN32)
+  const DWORD tid = slot->host_tid.load(std::memory_order_relaxed);
+  HANDLE handle = OpenThread(THREAD_SUSPEND_RESUME | THREAD_GET_CONTEXT | THREAD_QUERY_INFORMATION,
+                             FALSE, tid);
+  if (!handle) return;
+  if (SuspendThread(handle) != static_cast<DWORD>(-1)) {
+    CONTEXT context{};
+    context.ContextFlags = CONTEXT_CONTROL | CONTEXT_INTEGER;
+    if (GetThreadContext(handle, &context)) {
+      if (g_spin_sampling.load(std::memory_order_relaxed)) {
+        const uint32_t sample = slot->spin_count.fetch_add(1, std::memory_order_relaxed);
+        if (sample < kMaxSpinSamples) {
+          slot->spin_pc[sample].store(context.Rip, std::memory_order_relaxed);
+        }
+      }
+      slot->cap_pc[0].store(context.Rip, std::memory_order_relaxed);
+      uint32_t depth = 1;
+      uint64_t rbp = context.Rbp;
+      while (depth < kMaxCaptureDepth && rbp) {
+        MEMORY_BASIC_INFORMATION info{};
+        if (VirtualQuery(reinterpret_cast<void*>(rbp), &info, sizeof(info)) == 0 ||
+            info.State != MEM_COMMIT || (info.Protect & PAGE_NOACCESS)) {
+          break;
+        }
+        uint64_t* frame = reinterpret_cast<uint64_t*>(rbp);
+        const uint64_t next = frame[0];
+        const uint64_t ret = frame[1];
+        if (ret == 0) break;
+        slot->cap_pc[depth++].store(ret, std::memory_order_relaxed);
+        if (next <= rbp) break;
+        rbp = next;
+      }
+      slot->cap_depth.store(depth, std::memory_order_release);
+    }
+    ResumeThread(handle);
+  }
+  CloseHandle(handle);
+#else
+  const uint32_t tid = slot->host_tid.load(std::memory_order_relaxed);
+  if (tid == 0) return;
+  syscall(SYS_tgkill, getpid(), static_cast<pid_t>(tid), g_capture_signal);
+#endif
+}
+
+void CaptureAllThreads() {
+  for (int i = 0; i < kMaxThreads; ++i) {
+    ThreadSlot& slot = g_slots[i];
+    if (!slot.active.load(std::memory_order_acquire)) continue;
+    slot.cap_depth.store(0, std::memory_order_release);
+  }
+  for (int i = 0; i < kMaxThreads; ++i) {
+    ThreadSlot& slot = g_slots[i];
+    if (!slot.active.load(std::memory_order_acquire)) continue;
+    RequestCapture(&slot);
+  }
+  // Give runnable threads time to take the signal / be suspended-read.
+  std::this_thread::sleep_for(std::chrono::milliseconds(150));
+}
+
+// For each candidate spinning slot, collect kMaxSpinSamples leaf host PCs
+// over ~1 s (all candidates in parallel). A spinning thread takes the capture
+// signal promptly; a blocked one is skipped by the caller.
+void SampleSpinPcs(const int* indices, int count) {
+  if (count <= 0) return;
+  for (int n = 0; n < count; ++n) {
+    ThreadSlot& slot = g_slots[indices[n]];
+    slot.spin_count.store(0, std::memory_order_release);
+    for (uint32_t i = 0; i < kMaxSpinSamples; ++i) {
+      slot.spin_pc[i].store(0, std::memory_order_relaxed);
+    }
+  }
+  g_spin_sampling.store(true, std::memory_order_release);
+  for (int round = 0; round < kMaxSpinSamples; ++round) {
+    for (int n = 0; n < count; ++n) {
+      RequestCapture(&g_slots[indices[n]]);
+    }
+    std::this_thread::sleep_for(std::chrono::milliseconds(kSpinSampleIntervalMs));
+  }
+  g_spin_sampling.store(false, std::memory_order_release);
+}
+
+std::string ReadHostState(uint32_t tid) {
+#if defined(_WIN32)
+  (void)tid;
+  return "?";
+#else
+  std::ifstream input("/proc/self/task/" + std::to_string(tid) + "/stat");
+  std::string line;
+  if (!input || !std::getline(input, line)) return "?";
+  const size_t name_end = line.rfind(") ");
+  if (name_end == std::string::npos || name_end + 2 >= line.size()) return "?";
+  return std::string(1, line[name_end + 2]);
+#endif
+}
+
+std::string ReadTailLines(const std::string& path, size_t max_lines) {
+  std::ifstream file(path, std::ios::binary);
+  if (!file) return {};
+  file.seekg(0, std::ios::end);
+  const std::streamoff size = file.tellg();
+  if (size <= 0) return {};
+  const std::streamoff chunk = 65536;
+  std::string data;
+  std::streamoff pos = size;
+  size_t newlines = 0;
+  while (pos > 0 && newlines <= max_lines) {
+    const size_t read_size = static_cast<size_t>(std::min<std::streamoff>(chunk, pos));
+    pos -= static_cast<std::streamoff>(read_size);
+    std::string buffer(read_size, '\0');
+    file.seekg(pos);
+    file.read(buffer.data(), static_cast<std::streamsize>(read_size));
+    data.insert(0, buffer);
+    newlines = static_cast<size_t>(std::count(data.begin(), data.end(), '\n'));
+  }
+  size_t cursor = data.size();
+  size_t count = 0;
+  while (cursor > 0 && count <= max_lines) {
+    --cursor;
+    if (data[cursor] == '\n') {
+      ++count;
+      if (count > max_lines) {
+        ++cursor;
+        break;
+      }
+    }
+  }
+  return data.substr(cursor);
+}
+
+int ActiveThreadCount() {
+  return std::popcount(g_used_mask.load(std::memory_order_relaxed));
+}
+
+std::string ReportDir() {
+  const std::string log_file = REXCVAR_GET(log_file);
+  if (!log_file.empty()) {
+    std::filesystem::path parent = std::filesystem::path(log_file).parent_path();
+    if (!parent.empty()) return parent.string();
+  }
+  std::error_code error;
+  return rex::filesystem::GetExecutableFolder().string();
+}
+
+// Keeps the newest `keep` files in `dir` whose name starts with `prefix`.
+void PruneReports(const std::string& dir, const std::string& prefix, size_t keep) {
+  std::error_code error;
+  std::vector<std::filesystem::path> found;
+  for (const auto& entry : std::filesystem::directory_iterator(dir, error)) {
+    const std::string name = entry.path().filename().string();
+    if (name.rfind(prefix, 0) == 0) found.push_back(entry.path());
+  }
+  if (found.size() <= keep) return;
+  // Names embed YYYYmmdd-HHMMSS, so lexical order is age order.
+  std::sort(found.begin(), found.end());
+  for (size_t i = 0; i + keep < found.size(); ++i) std::filesystem::remove(found[i], error);
+}
+
+// at_close: snapshot taken when the player closes the window (the picture may
+// be frozen while presents continue, GitHub #21/#25), not a present-gap freeze.
+void GenerateReport(uint64_t now_ns, uint64_t last_present_ns, bool at_close) {
+  const uint64_t last_vdswap_ns = g_last_vdswap_ns.load(std::memory_order_acquire);
+#if !defined(_WIN32)
+  LoadSymbols();
+#endif
+  CaptureAllThreads();
+
+  // Classify every active thread spin/blocked/idle from its recent CPU
+  // history, then multi-sample the host PC of the spinning ones.
+  double cpu_percent[kMaxThreads] = {};
+  const char* thread_class[kMaxThreads] = {};
+  int spin_indices[kMaxThreads] = {};
+  int spin_count = 0;
+  int top_spin = -1;
+  for (int i = 0; i < kMaxThreads; ++i) {
+    if (!g_slots[i].active.load(std::memory_order_acquire)) continue;
+    cpu_percent[i] = SlotCpuPercent(i);
+    thread_class[i] = ClassifyThread(i, cpu_percent[i]);
+    if (std::strcmp(thread_class[i], "spin") == 0) {
+      spin_indices[spin_count++] = i;
+      if (top_spin < 0 || cpu_percent[i] > cpu_percent[top_spin]) top_spin = i;
+    }
+  }
+  SampleSpinPcs(spin_indices, spin_count);
+  // Wait ages use a clock read AFTER capture/sampling: threads that cycle
+  // through short waits re-arm wait_since during that ~0.15-1.2 s, and an age
+  // against the earlier now_ns would underflow.
+  const uint64_t wait_now_ns = NowNs();
+  auto wait_age_s = [wait_now_ns](uint64_t since) {
+    return since >= wait_now_ns ? 0.0 : double(wait_now_ns - since) / 1e9;
+  };
+
+  char stamp[32] = {};
+  const std::time_t t = std::time(nullptr);
+  std::tm local{};
+#if defined(_WIN32)
+  localtime_s(&local, &t);
+#else
+  localtime_r(&t, &local);
+#endif
+  std::strftime(stamp, sizeof(stamp), "%Y%m%d-%H%M%S", &local);
+
+  const std::string dir = ReportDir();
+  const char* prefix = at_close ? "wwe13-exit-" : "wwe13-freeze-";
+  if (at_close) PruneReports(dir, prefix, kKeepExitSnapshots - 1);
+  const std::string path = dir + "/" + prefix + stamp + ".txt";
+  FILE* file = std::fopen(path.c_str(), "wb");
+  if (!file) {
+    REXLOG_WARN("[freeze-logger] freeze detected but cannot write {}", path);
+    return;
+  }
+  const double gap_s = double(now_ns - last_present_ns) / 1e9;
+  const double vdswap_gap_s =
+      last_vdswap_ns ? double(now_ns - last_vdswap_ns) / 1e9 : -1.0;
+  std::fprintf(file, at_close ? "WWE 13 exit snapshot\n" : "WWE 13 freeze report\n");
+  std::fprintf(file, "generated: %s  uptime_s=%.1f\n", stamp, double(now_ns - g_start_ns) / 1e9);
+  if (at_close) {
+    std::fprintf(file,
+                 "trigger: window closed by the player (if the picture was frozen, look for "
+                 "threads blocked for a long time below)\n");
+  } else {
+    std::fprintf(file, "trigger: no frame presented for %.1f s (threshold %d s)\n", gap_s,
+                 kFreezeGapSeconds);
+  }
+  std::fprintf(file, "present: total=%llu last=%.1f s ago\n",
+               (unsigned long long)g_present_count.load(std::memory_order_relaxed), gap_s);
+  std::fprintf(file, "vdswap: total=%llu last=%.1f s ago\n",
+               (unsigned long long)g_vdswap_count.load(std::memory_order_relaxed), vdswap_gap_s);
+  std::fprintf(file, "sync_events_recorded=%llu\n",
+               (unsigned long long)g_event_count.load(std::memory_order_relaxed));
+
+  std::fprintf(file, "\n=== guest threads (%d slots) ===\n", kMaxThreads);
+  for (int i = 0; i < kMaxThreads; ++i) {
+    ThreadSlot& slot = g_slots[i];
+    if (!slot.active.load(std::memory_order_acquire)) continue;
+    const uint32_t host_tid = slot.host_tid.load(std::memory_order_relaxed);
+    const uint32_t guest_id = slot.guest_id.load(std::memory_order_relaxed);
+    const uint64_t wait_since = slot.wait_since_ns.load(std::memory_order_acquire);
+    const char* cls = thread_class[i] ? thread_class[i] : "unknown";
+    if (cpu_percent[i] >= 0.0) {
+      std::fprintf(file, "slot=%d name=%s guest_id=%u host_tid=%u host_state=%s cpu=%.1f%% class=%s\n",
+                   i, slot.name, guest_id, host_tid, ReadHostState(host_tid).c_str(),
+                   cpu_percent[i], cls);
+    } else {
+      std::fprintf(file, "slot=%d name=%s guest_id=%u host_tid=%u host_state=%s cpu=? class=%s\n", i,
+                   slot.name, guest_id, host_tid, ReadHostState(host_tid).c_str(), cls);
+    }
+    if (wait_since != 0) {
+      char wait_name[sizeof(slot.wait_name) + 1] = {};
+      std::memcpy(wait_name, slot.wait_name, sizeof(slot.wait_name));
+      std::fprintf(file, "  waiting_on: handle=0x%08X type=%s name=\"%s\" for %.1f s guest_lr=0x%llX\n",
+                   slot.wait_handle.load(std::memory_order_relaxed),
+                   ObjectTypeName(slot.wait_object_type.load(std::memory_order_relaxed)), wait_name,
+                   wait_age_s(wait_since),
+                   (unsigned long long)slot.wait_lr.load(std::memory_order_relaxed));
+    } else {
+      std::fprintf(file, "  waiting_on: (not blocked in a kernel wait)\n");
+    }
+    if (std::strcmp(cls, "spin") == 0) {
+      const uint32_t samples = std::min<uint32_t>(slot.spin_count.load(std::memory_order_acquire),
+                                                  kMaxSpinSamples);
+      std::fprintf(file, "  spin_samples=%u\n", samples);
+      for (uint32_t s = 0; s < samples; ++s) {
+        const uint64_t pc = slot.spin_pc[s].load(std::memory_order_relaxed);
+        if (pc == 0) continue;
+        const char* sym = SymbolizeHostPc(pc);
+        std::fprintf(file, "    spin_pc[%u]=0x%llx sym=%s\n", s, (unsigned long long)pc,
+                     sym ? sym : "?");
+      }
+    }
+    const uint32_t depth = std::min<uint32_t>(slot.cap_depth.load(std::memory_order_acquire),
+                                              kMaxCaptureDepth);
+    if (depth > 0) {
+      std::fprintf(file, "  capture: host_pc_count=%u\n", depth);
+      for (uint32_t d = 0; d < depth; ++d) {
+        const uint64_t pc = slot.cap_pc[d].load(std::memory_order_relaxed);
+        const char* sym = SymbolizeHostPc(pc);
+        std::fprintf(file, "    pc[%u]=0x%llx sym=%s\n", d, (unsigned long long)pc,
+                     sym ? sym : "?");
+      }
+    } else {
+      std::fprintf(file, "  capture: none (thread blocked and did not run)\n");
+    }
+  }
+
+  // Access-violation recovery accounting, with age relative to the freeze.
+  std::fprintf(file, "\n=== memory recoveries ===\n");
+  static const char* kRecoveryNames[] = {
+      "guest-virtual-stale-protection",
+      "released-guest-physical",
+      "stale-guest-physical-write",
+  };
+  for (int i = 0; i < static_cast<int>(MemoryRecoveryKind::kCount); ++i) {
+    const RecoverySlot& slot = g_recovery[i];
+    const uint64_t count = slot.count.load(std::memory_order_relaxed);
+    const uint64_t last_ns = slot.last_ns.load(std::memory_order_acquire);
+    std::fprintf(file, "%s: count=%llu last_guest=0x%08X last_protect=0x%08X last_age_s=%.1f\n",
+                 kRecoveryNames[i], (unsigned long long)count,
+                 slot.last_guest.load(std::memory_order_relaxed),
+                 slot.last_protect.load(std::memory_order_relaxed),
+                 last_ns ? double(now_ns - last_ns) / 1e9 : -1.0);
+  }
+
+  // Guest-memory state (optional game-specific values), supplied by
+  // the game because rexcore cannot reach rex::system.
+  std::fprintf(file, "\n=== guest state ===\n");
+  if (g_guest_state_dump) {
+    g_guest_state_dump(file, now_ns);
+  } else {
+    std::fprintf(file, "(no guest-state provider registered)\n");
+  }
+
+  const uint64_t write = g_ring_write.load(std::memory_order_acquire);
+  const uint64_t begin = write > kRingSize ? write - kRingSize : 0;
+  std::fprintf(file, "\n=== sync ring (oldest..newest; %llu total) ===\n",
+               (unsigned long long)write);
+  std::fprintf(file, "%s\n", "seq kind host_tid guest_id t_ms handle type name");
+  static const char* kKindNames[] = {
+      "unknown", "create", "set", "reset", "pulse", "sem-release",
+      "wait-begin", "wait-end", "thread-create", "thread-exit",
+  };
+  for (uint64_t seq = begin; seq < write; ++seq) {
+    RingSlot& entry = g_ring[seq % kRingSize];
+    if (entry.seq.load(std::memory_order_acquire) != seq * 2 + 2) continue;
+    const SyncRecord& rec = entry.rec;
+    const char* kind = rec.kind < sizeof(kKindNames) / sizeof(kKindNames[0])
+                           ? kKindNames[rec.kind]
+                           : "?";
+    std::fprintf(file, "%llu %s %u %u %.1f 0x%08X %s %s\n", (unsigned long long)seq, kind,
+                 rec.host_tid, rec.guest_id, double(rec.t_ns) / 1e6, rec.handle,
+                 ObjectTypeName(rec.object_type), rec.name);
+  }
+
+  const std::string log_path = REXCVAR_GET(log_file);
+  std::fprintf(file, "\n=== last 200 game log lines (%s) ===\n",
+               log_path.empty() ? "(no --log_file)" : log_path.c_str());
+  if (!log_path.empty()) {
+    const std::string tail = ReadTailLines(log_path, 200);
+    std::fwrite(tail.data(), 1, tail.size(), file);
+  }
+  std::fclose(file);
+
+  if (at_close) {
+    // A healthy game already has ~10 threads parked in long waits (main thread on
+    // GameMainThreadEvent, idle workers), so the per-thread table stays in the
+    // file; the game log only gets the count.
+    int long_blocked = 0;
+    for (int i = 0; i < kMaxThreads; ++i) {
+      if (!g_slots[i].active.load(std::memory_order_acquire)) continue;
+      const uint64_t wait_since = g_slots[i].wait_since_ns.load(std::memory_order_acquire);
+      if (wait_since != 0 && wait_age_s(wait_since) >= kLongWaitSeconds) ++long_blocked;
+    }
+    REXLOG_INFO("[freeze-logger] wrote exit snapshot {} ({} threads, {} blocked >= {} s)", path,
+                ActiveThreadCount(), long_blocked, kLongWaitSeconds);
+    return;
+  }
+  REXLOG_WARN(
+      "[freeze-logger] no frame presented for {:.1f} s; wrote freeze report {} ({} threads, {} ring "
+      "events)",
+      gap_s, path, ActiveThreadCount(),
+      (unsigned long long)g_event_count.load(std::memory_order_relaxed));
+  // Subject of the summary: the thread that last drove VdSwap (it is the one
+  // that stops producing frames), falling back to the highest-CPU spinner.
+  int subject = -1;
+  const uint32_t vdswap_tid = g_last_vdswap_host_tid.load(std::memory_order_relaxed);
+  for (int i = 0; i < kMaxThreads; ++i) {
+    if (!g_slots[i].active.load(std::memory_order_acquire)) continue;
+    if (g_slots[i].host_tid.load(std::memory_order_relaxed) == vdswap_tid) {
+      subject = i;
+      break;
+    }
+  }
+  if (subject < 0) subject = top_spin;
+  if (subject >= 0 &&
+      (std::strcmp(thread_class[subject] ? thread_class[subject] : "", "spin") == 0 ||
+       std::strcmp(thread_class[subject] ? thread_class[subject] : "", "blocked") == 0)) {
+    /* use it */;
+  } else if (top_spin >= 0) {
+    subject = top_spin;
+  }
+  if (subject >= 0 && std::strcmp(thread_class[subject] ? thread_class[subject] : "", "spin") == 0) {
+    const ThreadSlot& slot = g_slots[subject];
+    // Majority symbol among the sampled leaf PCs.
+    const uint32_t samples =
+        std::min<uint32_t>(slot.spin_count.load(std::memory_order_acquire), kMaxSpinSamples);
+    const char* top_sym = "?";
+    uint32_t top_count = 0;
+    for (uint32_t s = 0; s < samples; ++s) {
+      const uint64_t pc = slot.spin_pc[s].load(std::memory_order_relaxed);
+      if (pc == 0) continue;
+      const char* sym = SymbolizeHostPc(pc);
+      if (!sym) continue;
+      uint32_t hits = 0;
+      for (uint32_t j = 0; j < samples; ++j) {
+        const uint64_t other = slot.spin_pc[j].load(std::memory_order_relaxed);
+        if (other != 0 && SymbolizeHostPc(other) == sym) ++hits;
+      }
+      if (hits > top_count) {
+        top_count = hits;
+        top_sym = sym;
+      }
+    }
+    REXLOG_WARN("[freeze-logger] class=spin tid={} name={} leaf={} cpu={:.1f}% samples={}",
+                slot.host_tid.load(std::memory_order_relaxed), slot.name, top_sym,
+                cpu_percent[subject], samples);
+  } else {
+    int blocked = -1;
+    uint64_t oldest_wait = 0;
+    int blocked_count = 0;
+    for (int i = 0; i < kMaxThreads; ++i) {
+      if (!g_slots[i].active.load(std::memory_order_acquire)) continue;
+      const uint64_t wait_since = g_slots[i].wait_since_ns.load(std::memory_order_acquire);
+      if (wait_since == 0) continue;
+      ++blocked_count;
+      // The test hook's synthetic wait is the injected block: always prefer it.
+      if (std::strcmp(g_slots[i].wait_name, "wwe13-freeze-test") == 0) {
+        blocked = i;
+        oldest_wait = wait_since;
+        break;
+      }
+      // Otherwise prefer the vdswap subject, then the oldest wait.
+      if (i == subject && blocked < 0) {
+        blocked = i;
+        oldest_wait = wait_since;
+        continue;
+      }
+      if (blocked < 0 || wait_since < oldest_wait) {
+        blocked = i;
+        oldest_wait = wait_since;
+      }
+    }
+    if (blocked >= 0) {
+      const ThreadSlot& slot = g_slots[blocked];
+      char wait_name[sizeof(slot.wait_name) + 1] = {};
+      std::memcpy(wait_name, slot.wait_name, sizeof(slot.wait_name));
+      REXLOG_WARN(
+          "[freeze-logger] class=blocked tid={} name={} waiting_on=\"{}\" handle=0x{:08X} "
+          "blocked_threads={}",
+          slot.host_tid.load(std::memory_order_relaxed), slot.name, wait_name,
+          slot.wait_handle.load(std::memory_order_relaxed), blocked_count);
+    } else {
+      REXLOG_WARN("[freeze-logger] class=no-spin-or-block (see report {})", path);
+    }
+  }
+  REXLOG_WARN("[freeze-logger] report path: {}", path);
+}
