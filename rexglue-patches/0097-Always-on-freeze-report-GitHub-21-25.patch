+void RecordPresent() {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  g_last_present_ns.store(NowNs(), std::memory_order_release);
+  g_present_count.fetch_add(1, std::memory_order_relaxed);
+  g_last_present_host_tid.store(rex::thread::current_thread_system_id(),
+                                std::memory_order_relaxed);
+  g_reported.store(false, std::memory_order_release);
+}
+bool TestBlockVdSwapOnce() {
+  static const bool armed = [] {
+    const char* value = std::getenv("WWE13_FREEZE_TEST_BLOCK");
+    return value != nullptr && *value != '\0';
+  }();
+  if (!armed) return false;
+  static const uint64_t delay_ns = [] {
+    const char* value = std::getenv("WWE13_FREEZE_TEST_BLOCK");
+    char* end = nullptr;
+    const long seconds = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || seconds <= 0) return uint64_t(60) * 1000000000ull;
+    return uint64_t(seconds) * 1000000000ull;
+  }();
+  static std::atomic<bool> triggered{false};
+  if (triggered.load(std::memory_order_acquire)) return false;
+  if (NowNs() - g_start_ns < delay_ns) return false;
+  bool expected = false;
+  if (!triggered.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) return false;
+  RecordWaitBegin(0, 2 /* Event */, "wwe13-freeze-test", 0);
+  REXLOG_WARN(
+      "[freeze-logger] positive control: blocking guest VdSwap thread tid={} on "
+      "wwe13-freeze-test",
+      rex::thread::current_thread_system_id());
+  return true;
+}
+
+// Spin positive control: busy-loop the guest VdSwap thread in a named,
+// noinline host function so the report can classify class=spin and name it.
+extern "C" {
+#if defined(__GNUC__) || defined(__clang__)
+__attribute__((noinline))
+#endif
+void wwe13_freeze_test_spin() {
+  volatile uint64_t counter = 0;
+  for (;;) {
+    counter = counter + 1;
+  }
+}
+}  // extern "C"
+
+
+bool TestSpinVdSwapOnce() {
+  static const bool armed = [] {
+    const char* value = std::getenv("WWE13_FREEZE_TEST_SPIN");
+    return value != nullptr && *value != '\0';
+  }();
+  if (!armed) return false;
+  static const uint64_t delay_ns = [] {
+    const char* value = std::getenv("WWE13_FREEZE_TEST_SPIN");
+    char* end = nullptr;
+    const long seconds = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || seconds <= 0) return uint64_t(60) * 1000000000ull;
+    return uint64_t(seconds) * 1000000000ull;
+  }();
+  static std::atomic<bool> triggered{false};
+  if (triggered.load(std::memory_order_acquire)) return false;
+  if (NowNs() - g_start_ns < delay_ns) return false;
+  bool expected = false;
+  if (!triggered.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) return false;
+  REXLOG_WARN("[freeze-logger] positive control: spinning guest VdSwap thread tid={}",
+              rex::thread::current_thread_system_id());
+  return true;
+}
+
+void RecordVdSwap() {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  // Remember the thread that drives presents (the prime suspect when frames
+  // stop); stored before the test hooks so a hook that never returns still
+  // leaves its tid for the report.
+  g_last_vdswap_host_tid.store(rex::thread::current_thread_system_id(),
+                               std::memory_order_relaxed);
+  if (TestBlockVdSwapOnce()) {
+    for (;;) std::this_thread::sleep_for(std::chrono::seconds(1));
+  }
+  if (TestSpinVdSwapOnce()) {
+    wwe13_freeze_test_spin();
+  }
+  g_last_vdswap_ns.store(NowNs(), std::memory_order_release);
+  g_vdswap_count.fetch_add(1, std::memory_order_relaxed);
+}
+
+void RecordSyncEvent(SyncType type, uint32_t handle, uint32_t object_type, const char* name) {
+  PushEvent(type, handle, object_type, name);
+}
+
+// Test hook for the GitHub #21/#25 shape: WWE13_FREEZE_TEST_STALL=<seconds>
+// parks the first guest thread that enters a kernel wait after that delay
+// (never the VdSwap/present threads) forever, so presents continue while that
+// thread is stuck. The exit snapshot must then name it.
+// WWE13_FREEZE_TEST_STALL_ON=<substring> restricts it to a wait object whose
+// name contains that text (e.g. the file loader's event, as in GitHub #25).
+bool TestStallWaitOnce(const char* wait_name) {
+  static const uint64_t delay_ns = []() -> uint64_t {
+    const char* value = std::getenv("WWE13_FREEZE_TEST_STALL");
+    if (!value || !*value) return uint64_t(0);
+    char* end = nullptr;
+    const long seconds = std::strtol(value, &end, 10);
+    if (end == value || *end != '\0' || seconds <= 0) return uint64_t(60) * 1000000000ull;
+    return uint64_t(seconds) * 1000000000ull;
+  }();
+  if (delay_ns == 0) return false;
+  static std::atomic<bool> triggered{false};
+  if (triggered.load(std::memory_order_relaxed)) return false;
+  if (NowNs() - g_start_ns < delay_ns) return false;
+  static const char* only_on = std::getenv("WWE13_FREEZE_TEST_STALL_ON");
+  if (only_on && *only_on && (!wait_name || !std::strstr(wait_name, only_on))) return false;
+  const uint32_t tid = rex::thread::current_thread_system_id();
+  if (tid == g_last_vdswap_host_tid.load(std::memory_order_relaxed) ||
+      tid == g_last_present_host_tid.load(std::memory_order_relaxed)) {
+    return false;
+  }
+  bool expected = false;
+  return triggered.compare_exchange_strong(expected, true, std::memory_order_acq_rel);
+}
+
+void RecordWaitBegin(uint32_t handle, uint32_t object_type, const char* name, uint64_t guest_lr) {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  ThreadSlot* slot = t_slot;
+  if (slot) {
+    slot->wait_handle.store(handle, std::memory_order_relaxed);
+    slot->wait_object_type.store(object_type, std::memory_order_relaxed);
+    slot->wait_lr.store(guest_lr, std::memory_order_relaxed);
+    if (name && *name) {
+      std::strncpy(slot->wait_name, name, sizeof(slot->wait_name) - 1);
+    } else {
+      slot->wait_name[0] = '\0';
+    }
+    slot->wait_since_ns.store(NowNs(), std::memory_order_release);
+  }
+  PushEvent(SyncType::kWaitBegin, handle, object_type, name);
+  if (slot && TestStallWaitOnce(name)) {
+    REXLOG_WARN("[freeze-logger] positive control: stalling guest thread tid={} name={} in its wait "
+                "on \"{}\" handle=0x{:08X}",
+                rex::thread::current_thread_system_id(), slot->name, slot->wait_name, handle);
+    for (;;) std::this_thread::sleep_for(std::chrono::seconds(1));
+  }
+}
+
+void RecordWaitEnd(uint32_t handle) {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  ThreadSlot* slot = t_slot;
+  if (slot) slot->wait_since_ns.store(0, std::memory_order_release);
+  PushEvent(SyncType::kWaitEnd, handle, 0, nullptr);
+}
+
+void RegisterThread(uint32_t guest_thread_id, const char* name) {
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  int index = -1;
+  uint64_t mask = g_used_mask.load(std::memory_order_relaxed);
+  for (;;) {
+    if (mask == ~uint64_t(0)) break;
+    int candidate = 0;
+    while (candidate < kMaxThreads && (mask & (uint64_t(1) << candidate))) ++candidate;
+    if (candidate >= kMaxThreads) break;
+    if (g_used_mask.compare_exchange_weak(mask, mask | (uint64_t(1) << candidate),
+                                          std::memory_order_acq_rel)) {
+      index = candidate;
+      break;
+    }
+  }
+  if (index < 0) return;
+  ThreadSlot& slot = g_slots[index];
+  slot.guest_id.store(guest_thread_id, std::memory_order_relaxed);
+  slot.host_tid.store(rex::thread::current_thread_system_id(), std::memory_order_relaxed);
+  slot.wait_since_ns.store(0, std::memory_order_relaxed);
+  slot.cap_depth.store(0, std::memory_order_relaxed);
+  std::memset(slot.name, 0, sizeof(slot.name));
+  if (name && *name) std::strncpy(slot.name, name, sizeof(slot.name) - 1);
+  slot.active.store(true, std::memory_order_release);
+  t_slot = &slot;
+  RecordSyncEvent(SyncType::kThreadCreate, 0, 0, name);
+}
+
+void UnregisterThread() {
+  ThreadSlot* slot = t_slot;
+  t_slot = nullptr;
+  if (!slot) return;
+  if (!g_enabled.load(std::memory_order_relaxed)) return;
+  RecordSyncEvent(SyncType::kThreadExit, 0, 0, slot->name);
+  slot->wait_since_ns.store(0, std::memory_order_relaxed);
+  slot->active.store(false, std::memory_order_release);
+  const int index = static_cast<int>(slot - g_slots);
+  if (index >= 0 && index < kMaxThreads) {
+    g_used_mask.fetch_and(~(uint64_t(1) << index), std::memory_order_acq_rel);
+  }
+}
+
+namespace {
+
+void Watchdog() {
+  while (g_running.load(std::memory_order_acquire)) {
+    std::this_thread::sleep_for(std::chrono::seconds(1));
+    if (!g_running.load(std::memory_order_acquire)) break;
+    const uint64_t sample_time = NowNs();
+    // Keep a short per-thread CPU history so a report can classify
+    // spin vs blocked vs idle from the seconds before the freeze.
+    for (int i = 0; i < kMaxThreads; ++i) {
+      ThreadSlot& slot = g_slots[i];
+      if (!slot.active.load(std::memory_order_acquire)) continue;
+      const uint32_t tid = slot.host_tid.load(std::memory_order_relaxed);
+      const uint64_t cpu_ns = ReadHostCpuNs(tid);
+      if (cpu_ns == UINT64_MAX) continue;
+      const uint32_t head = g_cpu_history_head[i];
+      g_cpu_history[i][head] = {tid, cpu_ns, sample_time};
+      g_cpu_history_head[i] = (head + 1) % kCpuHistory;
+      if (g_cpu_history_count[i] < kCpuHistory) ++g_cpu_history_count[i];
+    }
+    // Load last_present before reading the clock for the gap so a present that
+    // races this tick cannot make now < last_present and underflow the gap.
+    const uint64_t last_present = g_last_present_ns.load(std::memory_order_acquire);
+    if (last_present == 0) continue;
+    const uint64_t now = NowNs();
+    if (now < last_present || now - last_present < uint64_t(kFreezeGapSeconds) * 1000000000ull) {
+      continue;
+    }
+    bool expected = false;
+    if (!g_reported.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) continue;
+    GenerateReport(now, last_present, false);
+  }
+}
+
+}  // namespace
+
+void Start() {
+  std::lock_guard<std::mutex> lock(g_lifecycle);
+  if (g_started.load(std::memory_order_acquire)) return;
+  g_started.store(true, std::memory_order_release);
+  const char* disable = std::getenv("WWE13_FREEZE_LOG");
+  const char* disable_generic = std::getenv("REX_FREEZE_LOG_DISABLE");
+  const bool disabled = (disable && std::strcmp(disable, "0") == 0) ||
+                        (disable_generic && std::strcmp(disable_generic, "1") == 0);
+  if (disabled) {
+    REXLOG_INFO("[freeze-logger] disabled by environment");
+    return;
+  }
+  g_start_ns = NowNs();
+  g_enabled.store(true, std::memory_order_release);
+  InstallCaptureHandler();
+  g_running.store(true, std::memory_order_release);
+  g_watchdog = std::thread(Watchdog);
+  std::atexit([] { Stop(); });
+  REXLOG_INFO("[freeze-logger] enabled: present-gap={} s report_dir={}", kFreezeGapSeconds,
+              ReportDir());
+  if (const char* bench = std::getenv("REX_FREEZE_LOG_BENCH"); bench && std::strcmp(bench, "1") == 0) {
+    constexpr int kIterations = 1000000;
+    const uint64_t begin = NowNs();
+    for (int i = 0; i < kIterations; ++i) {
+      RecordSyncEvent(SyncType::kEventSet, 0xF8000000u, 2, "bench");
+    }
+    const uint64_t elapsed = NowNs() - begin;
+    REXLOG_INFO("[freeze-logger] bench: {} pushes in {} ns = {:.1f} ns/push", kIterations,
+                (unsigned long long)elapsed, double(elapsed) / kIterations);
+  }
+}
+
+void Stop() {
+  std::lock_guard<std::mutex> lock(g_lifecycle);
+  if (!g_running.exchange(false)) return;
+  if (g_watchdog.joinable()) g_watchdog.join();
+}
+
+void SnapshotOnClose() {
+  if (!g_enabled.load(std::memory_order_acquire)) return;
+  // Nothing to explain before the first frame (e.g. closed on a load screen
+  // that never presented); the present-gap watchdog covers that case.
+  const uint64_t last_present = g_last_present_ns.load(std::memory_order_acquire);
+  if (last_present == 0) return;
+  // The watchdog may be writing a freeze report right now; never write both.
+  bool expected = false;
+  if (!g_reported.compare_exchange_strong(expected, true, std::memory_order_acq_rel)) return;
+  GenerateReport(NowNs(), last_present, true);
+}
+
+}  // namespace rex::diagnostics::freeze_logger
