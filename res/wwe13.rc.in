// Icon and file details of wwe13.exe (generated by CMake from res/wwe13.rc.in).
// SDL uses the first icon resource for the game window and the taskbar.
#include <winver.h>

1 ICON "@WWE13_RES_DIR@/wwe13.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WWE13_VERSION_MAJOR@,@WWE13_VERSION_MINOR@,@WWE13_VERSION_PATCH@,0
PRODUCTVERSION @WWE13_VERSION_MAJOR@,@WWE13_VERSION_MINOR@,@WWE13_VERSION_PATCH@,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "@WWE13_RC_DESCRIPTION@"
      VALUE "ProductName", "WWE '13 Recomp (unofficial)"
      VALUE "FileVersion", "@WWE13_VERSION@"
      VALUE "ProductVersion", "@WWE13_VERSION@"
      VALUE "InternalName", "@WWE13_RC_INTERNAL@"
      VALUE "OriginalFilename", "@WWE13_RC_FILENAME@"
      VALUE "Comments", "Fan project, not affiliated with WWE, THQ or Yuke's."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
